<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    
    <!-- Configuración para forzar UTF-8 durante la compilación -->
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
    
    <!-- Nombre final del ejecutable y ensamblado -->
    <AssemblyName>Steam Cleaner</AssemblyName>
    <RootNamespace>SteamCleaner</RootNamespace>
    
    <!-- Metadatos de Propiedades del Archivo -->
    <Title>Steam Cleaner</Title>
    <Description>Universal Steam Cleanup and Reset Utility</Description>
    <Company>RazToolsLMAO</Company>
    <Product>Steam Cleaner</Product>
    <Copyright>Copyright © 2026 RazDays._ All rights reserved.</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0</Version>
    
    <!-- Configuración del icono ejecutable -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

</Project>